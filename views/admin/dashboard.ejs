<%- include('../partials/header', { title: 'Admin Dashboard' }) %>

    <style>
        .stat-card {
            border: none;
            border-radius: 20px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1) !important;
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .admin-action-card {
            border: none;
            border-radius: 20px;
            background: #f8f9fa;
            transition: all 0.2s;
            cursor: pointer;
        }

        .admin-action-card:hover {
            background: #e9ecef;
        }
    </style>

    <div class="container mt-4 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold text-dark mb-0">Admin Overview</h1>
                <p class="text-muted">Welcome back, System Administrator</p>
            </div>
            <div class="text-end">
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                    <i class="fas fa-calendar-alt me-2"></i>
                    <%= new Date().toLocaleDateString() %>
                </span>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card stat-card shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                                <i class="fas fa-users"></i>
                            </div>
                            <span class="text-success small fw-bold"><i class="fas fa-arrow-up me-1"></i> 12%</span>
                        </div>
                        <h2 class="fw-bold mb-1">
                            <%= stats.users %>
                        </h2>
                        <p class="text-muted mb-0">Total Registered Users</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="stat-icon bg-success bg-opacity-10 text-success">
                                <i class="fas fa-store"></i>
                            </div>
                            <span class="text-primary small fw-bold"><i class="fas fa-plus me-1"></i> 3 New</span>
                        </div>
                        <h2 class="fw-bold mb-1">
                            <%= stats.stores %>
                        </h2>
                        <p class="text-muted mb-0">Partner Stores</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="stat-icon bg-info bg-opacity-10 text-info">
                                <i class="fas fa-shopping-cart"></i>
                            </div>
                            <span class="text-info small fw-bold"><i class="fas fa-history me-1"></i> Today</span>
                        </div>
                        <h2 class="fw-bold mb-1">
                            <%= stats.orders %>
                        </h2>
                        <p class="text-muted mb-0">Total Orders Processed</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                                <i class="fas fa-wallet"></i>
                            </div>
                            <span class="text-warning small fw-bold">KSH</span>
                        </div>
                        <h2 class="fw-bold mb-1">
                            <%= stats.revenue.toLocaleString() %>
                        </h2>
                        <p class="text-muted mb-0">Total GMV Revenue</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Quick Actions -->
            <div class="col-lg-8">
                <h4 class="fw-bold mb-4">Management Console</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <a href="/admin/users" class="text-decoration-none">
                            <div class="card admin-action-card p-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-white p-3 rounded-circle shadow-sm text-primary">
                                        <i class="fas fa-user-cog fa-lg"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-1 text-dark">User Management</h5>
                                        <p class="text-muted small mb-0">Manage roles and permissions</p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="/admin/stores" class="text-decoration-none">
                            <div class="card admin-action-card p-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-white p-3 rounded-circle shadow-sm text-success">
                                        <i class="fas fa-check-circle fa-lg"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-1 text-dark">Store Approvals</h5>
                                        <p class="text-muted small mb-0">Review new seller applications</p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Recent Logs (Placeholder) -->
            <div class="col-lg-4">
                <h4 class="fw-bold mb-4">System Alerts</h4>
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="alert alert-info border-0 rounded-3 mb-3 small">
                        <i class="fas fa-info-circle me-2"></i> 3 new stores pending approval.
                    </div>
                    <div class="alert alert-warning border-0 rounded-3 mb-0 small">
                        <i class="fas fa-exclamation-triangle me-2"></i> Database cleanup scheduled for 2AM.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>