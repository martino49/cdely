<%- include('../partials/header', { title: 'My Earnings' }) %>

    <div class="container mt-4 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
            <div>
                <h2 class="fw-bold text-dark mb-1">My Earnings</h2>
                <p class="text-muted mb-0">Track your daily income and performance</p>
            </div>
            <div class="bg-white p-1 rounded-pill shadow-sm border">
                <button class="btn btn-primary rounded-pill px-4">Daily</button>
                <button class="btn text-muted px-4">Weekly</button>
                <button class="btn text-muted px-4">Monthly</button>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white">
                    <h6 class="text-uppercase small fw-bold opacity-75 mb-3">Today's Revenue</h6>
                    <h1 class="display-6 fw-bold mb-0">KES <%= stats.total_earnings ?
                            stats.total_earnings.toLocaleString() : '0' %>
                    </h1>
                    <p class="small opacity-75 mt-3"><i class="fas fa-chart-line me-1"></i> +5% from yesterday</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h6 class="text-uppercase small fw-bold text-muted mb-3">Completed Jobs</h6>
                    <h2 class="fw-bold text-dark mb-0">
                        <%= stats.completed_deliveries || 0 %>
                    </h2>
                    <p class="small text-success mt-3 mb-0 fw-bold">100% completion rate</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h6 class="text-uppercase small fw-bold text-muted mb-3">Avg Per Delivery</h6>
                    <h2 class="fw-bold text-dark mb-0">KES <%= stats.avg_earnings ?
                            Math.round(stats.avg_earnings).toLocaleString() : '0' %>
                    </h2>
                    <div class="progress mt-3" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: 85%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Earnings History -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white border-0 p-4">
                <h5 class="fw-bold mb-0">Recent Payouts</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="bg-light bg-opacity-50">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">ID</th>
                            <th class="text-uppercase small fw-bold text-muted">Date</th>
                            <th class="text-uppercase small fw-bold text-muted">Order Ref</th>
                            <th class="text-uppercase small fw-bold text-muted">Amount</th>
                            <th class="pe-4 text-end text-uppercase small fw-bold text-muted">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (stats.history && stats.history.length> 0) { %>
                            <% stats.history.forEach(tx=> { %>
                                <tr>
                                    <td class="ps-4 py-3 fw-bold">#TRX-<%= tx.id %>
                                    </td>
                                    <td class="text-muted">
                                        <%= new Date(tx.date).toLocaleDateString() %>
                                    </td>
                                    <td class="fw-bold text-dark">#<%= tx.order_number %>
                                    </td>
                                    <td class="fw-bold text-success">+ KES <%= tx.amount.toLocaleString() %>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <span
                                            class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Paid</span>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted small">No recent payouts
                                                recorded.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>