<%- include('../partials/header', { title: store.name }) %>

    <style>
        :root {
            --primary-brand: #4361ee;
            --secondary-brand: #3f37c9;
            --accent-green: #2ecc71;
            --accent-red: #ff4757;
            --accent-gold: #ffc107;
            --bg-light: #f8f9fa;
            --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            --transition-base: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .store-hero-section {
            position: relative;
            padding-top: 20px;
            margin-bottom: 250px;
            /* Space for the floating info card */
        }

        .store-banner {
            width: 100%;
            height: 400px;
            border-radius: 24px;
            background: url('<%= store.banner_url || "https://images.unsplash.com/photo-1557821552-17105176677c?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80" %>') center/cover no-repeat;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .store-info-card {
            position: absolute;
            bottom: -180px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 1000px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            padding: 40px;
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            z-index: 5;
        }

        .store-logo-wrapper {
            position: absolute;
            top: -60px;
            background: white;
            padding: 6px;
            border-radius: 50%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .store-logo-circle {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
        }

        .store-title-row {
            margin-top: 60px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .store-name {
            font-size: 2.5rem;
            font-weight: 800;
            color: #2b2d42;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }

        .store-badges {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 20px;
        }

        .info-pill {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            background: #f1f3f9;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #4b5563;
        }

        .info-pill.rating {
            background: #fffcf0;
            color: #b45309;
        }

        .info-pill.time {
            background: #f0fdf4;
            color: #15803d;
        }

        .info-pill.category {
            background: #f5f3ff;
            color: #6d28d9;
        }

        .store-description {
            max-width: 700px;
            color: #6b7280;
            line-height: 1.6;
            font-size: 1.05rem;
            margin-bottom: 25px;
        }

        .store-actions {
            display: flex;
            gap: 12px;
        }

        .btn-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            border: 1.5px solid #edf2f7;
            color: #64748b;
            transition: var(--transition-base);
        }

        .btn-circle:hover {
            background: #f8fafc;
            transform: scale(1.05);
            color: var(--accent-red);
        }

        .btn-circle.active {
            color: var(--accent-red);
            border-color: var(--accent-red);
            background: #fff5f5;
        }

        /* Product Grid */
        .menu-section {
            padding: 60px 0;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 40px;
        }

        .section-title-group h2 {
            font-size: 2rem;
            font-weight: 800;
            color: #1a1a1a;
            margin-bottom: 5px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
        }

        .product-modern-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--card-shadow);
            transition: var(--transition-base);
            display: flex;
            flex-direction: column;
            height: 100%;
            border: 1px solid #f1f5f9;
        }

        .product-modern-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .product-image-container {
            position: relative;
            height: 220px;
            overflow: hidden;
        }

        .product-img-modern {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .product-modern-card:hover .product-img-modern {
            transform: scale(1.1);
        }

        .discount-tag {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--accent-red);
            color: white;
            padding: 6px 12px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.8rem;
            box-shadow: 0 4px 10px rgba(255, 71, 87, 0.3);
        }

        .product-details {
            padding: 24px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .product-name-modern {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 8px;
        }

        .product-desc-modern {
            font-size: 0.9rem;
            color: #64748b;
            margin-bottom: 20px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 2.7em;
        }

        .product-footer {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .price-wrapper {
            display: flex;
            flex-direction: column;
        }

        .original-price {
            font-size: 0.85rem;
            text-decoration: line-through;
            color: #94a3b8;
        }

        .current-price {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--primary-brand);
        }

        .add-to-cart-btn {
            background: #f1f5f9;
            color: #475569;
            border: none;
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition-base);
        }

        .add-to-cart-btn:hover {
            background: var(--primary-brand);
            color: white;
            transform: rotate(90deg);
        }

        /* Reviews */
        .reviews-modern-section {
            background: white;
            padding: 80px 0;
            border-radius: 40px 40px 0 0;
        }

        .review-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
            gap: 25px;
        }

        @media (max-width: 900px) {
            .review-grid {
                grid-template-columns: 1fr;
            }

            .store-hero-section {
                margin-bottom: 350px;
            }

            .store-info-card {
                bottom: -280px;
                padding: 30px 20px;
            }

            .store-name {
                font-size: 1.8rem;
            }
        }
    </style>

    <div class="container-fluid px-0">
        <div class="store-hero-section">
            <div class="container">
                <div class="store-banner"></div>
            </div>

            <div class="store-info-card">
                <div class="store-logo-wrapper">
                    <img src="<%= store.logo_url || 'https://via.placeholder.com/150' %>" class="store-logo-circle"
                        alt="<%= store.name %> logo">
                </div>

                <div class="store-title-row">
                    <h1 class="store-name">
                        <%= store.name %>
                    </h1>

                    <div class="store-badges">
                        <div class="info-pill rating">
                            <i class="fas fa-star"></i>
                            <%= store.rating || 'New' %> (<%= store.total_ratings || 0 %>)
                        </div>
                        <div class="info-pill time">
                            <i class="fas fa-motorcycle"></i>
                            <%= store.preparation_time || 30 %> min
                        </div>
                        <div class="info-pill category">
                            <i class="fas fa-tag"></i>
                            <%= store.category %>
                        </div>
                    </div>

                    <p class="store-description">
                        <%= store.description
                            || 'Welcome to our store! We serve the freshest and finest selections delivered straight to your door with speed and care.'
                            %>
                    </p>

                    <div class="store-actions">
                        <button class="btn-circle <%= store.is_favorited ? 'active' : '' %>"
                            onclick="toggleFavorite('<%= store.id %>', 'store', this)">
                            <i class="<%= store.is_favorited ? 'fas' : 'far' %> fa-heart"></i>
                        </button>
                        <button class="btn-circle">
                            <i class="fas fa-share-alt"></i>
                        </button>
                        <button class="btn-circle">
                            <i class="fas fa-info-circle"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container menu-section">
        <div class="section-header">
            <div class="section-title-group">
                <h2>Explore Menu</h2>
                <p class="text-muted">Choose your favorites from our curated selection</p>
            </div>
            <div class="category-filters d-none d-md-flex gap-2">
                <button class="btn btn-sm btn-dark rounded-pill px-3">All</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Featured</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">New</button>
            </div>
        </div>

        <% if (products && products.length> 0) { %>
            <div class="product-grid">
                <% products.forEach(product=> { %>
                    <div class="product-modern-card">
                        <div class="product-image-container">
                            <% let mainImage='https://via.placeholder.com/150' ; try { let images=[]; if
                                (product.image_urls) { if (typeof product.image_urls==='string' ) { if
                                (product.image_urls.trim().startsWith('[')) { images=JSON.parse(product.image_urls); }
                                else { images=[product.image_urls]; } } else if (Array.isArray(product.image_urls)) {
                                images=product.image_urls; } } if (images && images.length> 0) mainImage = images[0];
                                } catch(e) {
                                if (typeof product.image_urls === 'string') mainImage = product.image_urls;
                                }
                                %>
                                <img src="<%= mainImage %>" class="product-img-modern" alt="<%= product.name %>">

                                <% if (product.discounted_price && product.price> product.discounted_price) { %>
                                    <div class="discount-tag">
                                        -<%= Math.round(((product.price - product.discounted_price) / product.price) *
                                            100) %>%
                                    </div>
                                    <% } %>

                                        <button
                                            class="btn btn-white btn-sm rounded-circle position-absolute top-0 end-0 m-3 shadow-sm z-3 toggle-fav-btn"
                                            style="width: 38px; height: 38px;"
                                            onclick="toggleFavorite('<%= product.id %>', 'product', this)">
                                            <i
                                                class="<%= product.is_favorited ? 'fas' : 'far' %> fa-heart text-danger"></i>
                                        </button>
                        </div>

                        <div class="product-details">
                            <h3 class="product-name-modern">
                                <%= product.name %>
                            </h3>
                            <p class="product-desc-modern">
                                <%= product.description %>
                            </p>

                            <div class="product-footer">
                                <div class="price-wrapper">
                                    <% if (product.discounted_price) { %>
                                        <span class="original-price">KES <%= product.price %></span>
                                        <span class="current-price">KES <%= product.discounted_price %></span>
                                        <% } else { %>
                                            <span class="current-price">KES <%= product.price %></span>
                                            <% } %>
                                </div>

                                <form action="/customer/add-to-cart" method="POST">
                                    <input type="hidden" name="product_id" value="<%= product.id %>">
                                    <input type="hidden" name="store_id" value="<%= store.id %>">
                                    <input type="hidden" name="quantity" value="1">
                                    <button type="submit" class="add-to-cart-btn" title="Quick Add">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } else { %>
                <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-dashed">
                    <i class="fas fa-utensils fa-3x text-muted opacity-25 mb-3"></i>
                    <h4 class="fw-bold">Menu is currently empty</h4>
                    <p class="text-muted">Check back later for exciting new dishes!</p>
                </div>
                <% } %>
    </div>

    <div class="reviews-modern-section">
        <div class="container">
            <div class="section-header mb-5">
                <div class="section-title-group">
                    <h2>Guest Experiences</h2>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <span class="fs-4 fw-bold text-dark">
                            <%= store.rating || '0.0' %>
                        </span>
                        <div class="text-warning small d-flex gap-1">
                            <% for(let i=1; i<=5; i++) { %>
                                <i class="<%= i <= Math.round(store.rating || 0) ? 'fas' : 'far' %> fa-star"></i>
                                <% } %>
                        </div>
                        <span class="text-muted ms-2">Based on <%= store.total_ratings || 0 %> reviews</span>
                    </div>
                </div>
            </div>

            <% if (reviews && reviews.length> 0) { %>
                <div class="review-grid">
                    <% reviews.forEach(review=> { %>
                        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-light">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="<%= review.reviewer_avatar || 'https://ui-avatars.com/api/?name=' + review.reviewer_name %>"
                                        class="rounded-circle shadow-sm"
                                        style="width: 50px; height: 50px; object-fit: cover;">
                                    <div>
                                        <h6 class="fw-bold mb-0">
                                            <%= review.reviewer_name %>
                                        </h6>
                                        <small class="text-muted">
                                            <%= new Date(review.created_at).toLocaleDateString() %>
                                        </small>
                                    </div>
                                </div>
                                <div class="text-warning small d-flex gap-1">
                                    <% for(let i=1; i<=5; i++) { %>
                                        <i class="<%= i <= review.store_rating ? 'fas' : 'far' %> fa-star"></i>
                                        <% } %>
                                </div>
                            </div>
                            <p class="text-dark mb-0 fs-6 italic">
                                "<%= review.comment || review.store_comment || review.product_comment
                                    || 'An exceptional dining experience!' %>"
                            </p>
                        </div>
                        <% }) %>
                </div>
                <% } else { %>
                    <div class="text-center py-5 opacity-50">
                        <p class="fs-5">No reviews yet. Be the first to share your thoughts!</p>

                        // Handle Cart Forms via AJAX to prevent JSON from showing
                        document.querySelectorAll('form[action="/customer/add-to-cart"]').forEach(form => {
                    </div>
                    <% } %>
        </div>

        <script>
            // Toggle Favorite Function
            async function toggleFavorite(itemId, itemType, btn) {
                try {
                    const response = await fetch('/customer/favorites/toggle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ itemId, itemType })
                    });

                    const data = await response.json();

                    if (response.status === 401) {
                        window.location.href = '/auth/login';
                        return;
                    }

                    if (data.success) {
                        showToast('Success', data.message);
                        // Toggle heart icon class
                        const icon = btn.querySelector('i');
                        if (icon) {
                            icon.classList.toggle('fas');
                            icon.classList.toggle('far');
                        }
                        // Toggle active class for store favorite button
                        if (itemType === 'store') {
                            btn.classList.toggle('active');
                        }
                    } else {
                        showToast('Error', data.message || 'Failed to update favorite status.');
                    }
                } catch (error) {
                    console.error('Favorite toggle error:', error);
                    showToast('Error', 'An unexpected error occurred.');
                }
            }

            // Handle Cart Forms via AJAX to prevent JSON from showing
            document.querySelectorAll('form[action="/customer/add-to-cart"]').forEach(form => {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const formData = new FormData(form);
                    const params = new URLSearchParams(formData);

                    try {
                        const response = await fetch('/customer/add-to-cart', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'Accept': 'application/json'
                            },
                            body: params
                        });

                        const data = await response.json();

                        if (response.status === 401) {
                            window.location.href = '/auth/login';
                            return;
                        }

                        if (data.success) {
                            showToast('Cart Updated', 'Product added to cart successfully!');
                            // Optional: update cart count in navbar
                            const badge = document.querySelector('.navbar .badge');
                            if (badge) {
                                badge.innerText = data.cartCount;
                                badge.classList.remove('d-none');
                            }
                        } else {
                            showToast('Error', data.message || 'Failed to add to cart');
                        }
                    } catch (error) {
                        console.error('Cart error:', error);
                        window.location.href = '/customer/cart'; // Fallback to redirect
                    }
                });
            });
        </script>

        <%- include('../partials/footer') %>