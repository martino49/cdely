<%- include('../partials/header', { title: 'Financial Wallet' }) %>

    <div class="container mt-4 mb-5">
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white">
                    <h6 class="text-uppercase small fw-bold opacity-75 mb-3">Available Balance</h6>
                    <h1 class="display-5 fw-900 mb-2">KES <%= stats.pendingPayout.toLocaleString() %>
                    </h1>
                    <p class="small opacity-75 mb-4">Final balance after platform commission</p>
                    <button class="btn btn-white text-primary rounded-pill w-100 fw-bold py-2 shadow"
                        onclick="requestPayout()">
                        <i class="fas fa-paper-plane me-2"></i> Request Payout
                    </button>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <h6 class="text-uppercase small fw-bold text-muted mb-3">Total Lifetime Earnings</h6>
                    <h2 class="fw-900 text-dark mb-2">KES <%= stats.totalEarnings.toLocaleString() %>
                    </h2>
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center small">
                            <span class="text-muted">Last Payout:</span>
                            <span class="fw-bold text-dark">
                                <%= new Date(stats.lastPayout).toLocaleDateString() %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <h6 class="text-uppercase small fw-bold text-muted mb-3">Growth Index</h6>
                    <div class="d-flex align-items-center gap-3">
                        <h2 class="fw-900 text-success mb-0">+18%</h2>
                        <i class="fas fa-chart-line fa-2x text-success"></i>
                    </div>
                    <p class="small text-muted mt-3">Monthly performance compared to last period</p>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Transaction History</h5>
                <div class="btn-group shadow-sm border rounded-pill p-1">
                    <button class="btn btn-sm btn-pill btn-primary px-3">All</button>
                    <button class="btn btn-sm btn-pill px-3">Credits</button>
                    <button class="btn btn-sm btn-pill px-3">Debits</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase small text-muted">Reference</th>
                            <th class="text-uppercase small text-muted">Type</th>
                            <th class="text-uppercase small text-muted">Amount</th>
                            <th class="text-uppercase small text-muted">Description</th>
                            <th class="text-uppercase small text-muted text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% transactions.forEach(tx=> { %>
                            <tr>
                                <td class="ps-4 py-3 fw-bold">#TRX-<%= tx.id %>
                                </td>
                                <td>
                                    <% if (tx.type==='credit' ) { %>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">
                                            <i class="fas fa-plus x-small me-1"></i> Credit
                                        </span>
                                        <% } else { %>
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2">
                                                <i class="fas fa-minus x-small me-1"></i> Debit
                                            </span>
                                            <% } %>
                                </td>
                                <td class="fw-bold <%= tx.type === 'credit' ? 'text-success' : 'text-danger' %>">
                                    <%= tx.type==='credit' ? '+' : '-' %> KES <%= tx.amount.toLocaleString() %>
                                </td>
                                <td class="text-muted">
                                    <%= tx.description %>
                                </td>
                                <td class="pe-4 text-end">
                                    <span class="badge bg-light text-dark rounded-pill border fw-normal px-3">
                                        <%= tx.status.toUpperCase() %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function requestPayout() {
            Swal.fire({
                title: 'Request Payout',
                text: "Your available balance will be transferred to your primary bank account.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#4361ee',
                confirmButtonText: 'Confirm Transfer'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Success!',
                        text: 'Your payout request has been queued. Expect funds within 24 hours.',
                        icon: 'success'
                    });
                }
            });
        }
    </script>

    <style>
        .fw-900 {
            font-weight: 900;
        }

        .btn-white {
            background-color: white;
            border: none;
        }

        .btn-white:hover {
            background-color: rgba(255, 255, 255, 0.9);
        }

        .btn-pill {
            border: none !important;
            border-radius: 50px !important;
        }

        .x-small {
            font-size: 0.7rem;
        }
    </style>

    <%- include('../partials/footer') %>